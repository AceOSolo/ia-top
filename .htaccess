# =====================================================================
# IA Top — configuration du serveur Apache (hébergement OVH)
# IMPORTANT : le certificat SSL doit être activé dans l'espace client OVH
# AVANT la mise en ligne de ce fichier (voir README.md).
# =====================================================================

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8

# --- Redirections 301 : http -> https et www.iatop.eu -> iatop.eu ----
<IfModule mod_rewrite.c>
  RewriteEngine On

  # www.iatop.eu -> https://iatop.eu
  RewriteCond %{HTTP_HOST} ^www\.iatop\.eu$ [NC]
  RewriteRule ^ https://iatop.eu%{REQUEST_URI} [R=301,L]

  # http -> https (méthode recommandée par OVH)
  RewriteCond %{SERVER_PORT} 80
  RewriteCond %{HTTP_HOST} ^iatop\.eu$ [NC]
  RewriteRule ^ https://iatop.eu%{REQUEST_URI} [R=301,L]

  # /index.html -> / (une seule adresse pour la page d'accueil)
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ https://iatop.eu/ [R=301,L]
</IfModule>

# --- Page d'erreur personnalisée --------------------------------------
ErrorDocument 404 /404.html

# --- Types de fichiers -------------------------------------------------
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
  AddType image/x-icon .ico
  AddType application/manifest+json .webmanifest
</IfModule>

# --- Compression gzip --------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript text/javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/rss+xml image/svg+xml image/x-icon
</IfModule>

# --- Cache navigateur --------------------------------------------------
# Polices et images : 1 an. CSS et JS : 1 semaine. Pages HTML : pas de cache.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/javascript "access plus 1 week"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/xml "access plus 1 day"
  ExpiresByType text/plain "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(woff2|svg|png|jpe?g|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Sécurité de base (sans effet sur l'affichage)
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# --- Fichiers à ne jamais servir ---------------------------------------
<FilesMatch "^(README\.md|\.gitignore|\.git.*)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.git
RedirectMatch 404 ^/charte-ia-top/
